#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define Base        0
#define Nav         1
#define Sym         2
#define Fun         3
#define Game        4
#define Gameplus    5

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <125>;
            global-quick-tap;
            bindings = <&kp>, <&kp>;
        };

        fun_game: fun_game {
            compatible = "zmk,behavior-tap-dance";
            label = "FUN_GAME";
            #binding-cells = <0>;
            bindings = <&mo 3>, <&to 4>;
        };

        mac_del: mac_del {
            compatible = "zmk,behavior-mod-morph";
            label = "MAC_DEL";
            bindings = <&kp BACKSPACE>, <&kp DEL>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI|MOD_RGUI)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        NavNumToggle {
            bindings = <&tog 1>;
            key-positions = <16 17 18>;
            layers = <0 1>;
        };

        BaseToggle {
            bindings = <&tog 0>;
            key-positions = <6 7>;
            layers = <4>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "Base";
            bindings = <
                  &kp Q             &kp W           &kp E        &kp R           &kp T        &kp Y         &kp U                      &kp I            &kp O                 &kp P
                  &kp A             &kp S           &kp D        &kp F           &kp G        &kp H         &kp J                      &kp K            &kp L                 &kp SEMICOLON
&hm RCTRL ESCAPE  &hm LEFT_SHIFT Z  &hm LEFT_ALT X  &hm LCTRL C  &hm LEFT_GUI V  &kp B        &kp N         &hm RIGHT_GUI M            &hm RCTRL COMMA  &hm RIGHT_ALT PERIOD  &hm RIGHT_SHIFT SLASH  &kp RET
                                                    &fun_game    &lt 2 TAB       &kp SPACE    &lt 1 ESCAPE  &kp LS(LA(LC(RIGHT_GUI)))  &mac_del
            >;
        };

        NavNum {
            display-name = "Nav";
            bindings = <
        &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5    &kp HOME  &kp PG_DN  &kp PG_UP  &kp END    &trans
        &kp NUMBER_6  &kp N7        &kp N8        &kp N9        &kp N0    &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &trans
&trans  &trans        &trans        &trans        &trans        &trans    &trans    &trans     &trans     &trans     &trans  &kp LA(TAB)
                                    &trans        &trans        &trans    &trans    &trans     &trans
            >;
        };

        Symb {
            display-name = "Sym";
            bindings = <
           &kp EXCL  &kp AT  &kp HASH  &kp DOLLAR      &kp PERCENT             &kp CARET              &kp AMPERSAND    &kp ASTRK  &kp MINUS  &kp EQUAL
           &trans    &trans  &trans    &trans          &kp LEFT_PARENTHESIS    &kp RIGHT_PARENTHESIS  &trans           &trans     &trans     &kp SINGLE_QUOTE
&kp GRAVE  &trans    &trans  &trans    &kp LEFT_BRACE  &kp LEFT_BRACKET        &kp RIGHT_BRACKET      &kp RIGHT_BRACE  &trans     &trans     &kp DOUBLE_QUOTES  &trans
                             &trans    &trans          &trans                  &trans                 &trans           &trans
            >;
        };

        Fun {
            display-name = "Fun";
            bindings = <
        &trans  &trans  &trans  &kp C_NEXT        &kp C_VOLUME_UP    &trans  &kp F9  &kp F10  &kp F11  &kp F12
        &trans  &trans  &trans  &kp C_PREVIOUS    &kp C_VOL_DN       &trans  &kp F5  &kp F6   &kp F7   &kp F8
&trans  &trans  &trans  &trans  &kp C_PLAY_PAUSE  &kp K_MUTE         &trans  &kp F1  &kp F2   &kp F3   &kp F4   &kp PRINTSCREEN
                        &trans  &trans            &trans             &trans  &trans  &trans
            >;
        };

        Gaming {
            display-name = "Game";
            bindings = <
              &kp Z           &kp X  &kp C      &kp V         &kp B     &trans  &trans  &trans  &trans  &trans
              &kp TAB         &kp Q  &kp W      &kp E         &kp R     &trans  &trans  &trans  &trans  &trans
&lt 5 ESCAPE  &kp LEFT_SHIFT  &kp A  &kp S      &kp D         &kp F     &trans  &trans  &trans  &trans  &trans  &trans
                                     &kp LCTRL  &kp LEFT_ALT  &trans    &trans  &trans  &trans
            >;
        };

        Gaming+ {
            display-name = "Game+";
            bindings = <
        &to 0   &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp T    &kp RA(RC(Y))  &kp RA(RC(U))  &trans  &trans  &kp LC(RA(DEL))
        &kp L   &kp O         &kp Y         &kp K         &kp G    &kp F5         &kp F7         &trans  &trans  &kp F12
&trans  &trans  &trans        &trans        &trans        &kp H    &trans         &trans         &trans  &trans  &kp F22          &kp LA(F4)
                              &kp J         &kp I         &kp M    &trans         &trans         &trans
            >;
        };
    };
};
